{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WAM report schema version 1",
  "type": "object",
  "required": ["schema_version", "version", "project", "path", "ecosystems", "diagnostics", "summary"],
  "properties": {
    "schema_version": {"const": "1"},
    "version": {"type": "string"},
    "project": {"type": "string"},
    "path": {"type": "string"},
    "selection": {
      "type": "object",
      "required": ["excluded_directories"],
      "properties": {
        "excluded_directories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "ecosystems": {"type": "array", "items": {"type": "string"}},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "summary": {
      "type": "object",
      "required": ["passed", "failed", "warnings", "skipped"],
      "properties": {
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "required": ["id", "category", "name", "status", "description"],
      "properties": {
        "id": {"type": "string"},
        "category": {"type": "string"},
        "name": {"type": "string"},
        "status": {"enum": ["pass", "fail", "warn", "skip"]},
        "description": {"type": "string"},
        "required": {"type": "string"},
        "actual": {"type": "string"},
        "source": {"type": "string"},
        "line": {"type": "integer", "minimum": 1},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "suggestion": {"type": "string"},
        "environment": {"$ref": "#/$defs/environment"}
      }
    },
    "environment": {
      "type": "object",
      "required": ["kind", "present", "non_empty", "example_supplied", "default_supplied", "container_value_supplied", "explicitly_required", "confidence"],
      "properties": {
        "kind": {"enum": ["template", "compose-interpolation", "compose-passthrough", "compose-container"]},
        "present": {"type": "boolean"},
        "non_empty": {"type": "boolean"},
        "example_supplied": {"type": "boolean"},
        "default_supplied": {"type": "boolean"},
        "container_value_supplied": {"type": "boolean"},
        "explicitly_required": {"type": "boolean"},
        "confidence": {"enum": ["possible", "explicit-compose", "defaulted", "container-only"]}
      }
    }
  }
}
